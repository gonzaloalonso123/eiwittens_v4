PORT=8080

# Base64-encoded Firebase service account JSON
# Generate with: cat service_account.json | base64


# Comma-separated list of recipients for alert emails
ALERT_RECIPIENTS=huntymonster@gmail.com,gieriggroeien.nl@gmail.com

# Max warnings before an error alert is also sent (default: 15)
ALLOWED_WARNINGS=15

# Comma-separated allowed CORS origins
CORS_ORIGINS=https://dashboard.gieriggroeien.nl,https://eiwittens.web.app,http://localhost:3000

FIREBASE_CREDENTIALS=

OPENAI_API_KEY=sk-...

# Gmail SMTP (use an App Password, not your regular password)
GMAIL_USER=eiwittensmailer@gmail.com
GMAIL_PASSWORD=

# Bearer token Cloud Scheduler will send in Authorization header
SCRAPE_SECRET=
