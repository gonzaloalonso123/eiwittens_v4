PORT=8080

# Base64-encoded Firebase service account JSON
# Generate with: cat service_account.json | base64


# Comma-separated list of recipients for alert emails
ALERT_RECIPIENTS=huntymonster@gmail.com,gieriggroeien.nl@gmail.com

# Max warnings before an error alert is also sent (default: 15)
ALLOWED_WARNINGS=15

# Local/Cloud Run scrape tuning
SCRAPE_CONCURRENCY=3
SCRAPE_STALE_AFTER_MS=900000

# Optional debug filters for local or Cloud Run scrape jobs
# SCRAPE_LIMIT=5
# SCRAPE_PRODUCT_ID=firestore-product-id

# Comma-separated allowed CORS origins
CORS_ORIGINS=https://dashboard.gieriggroeien.nl,https://eiwittens.web.app,http://localhost:3000

FIREBASE_CREDENTIALS=

# Required: Anthropic API key for Claude Haiku 4.5 AI-fallback in scraper
ANTHROPIC_API_KEY=sk-ant-...

# Optional: legacy OpenAI key (extractor migrated to Anthropic). Can be empty.
OPENAI_API_KEY=

# Optional: full Awin Datafeed URL for MyProtein (with apikey + fid + columns)
# Get from Awin dashboard → Publisher → Datafeed → MyProtein NL
AWIN_FEED_MYPROTEIN_URL=

# Gmail SMTP (use an App Password, not your regular password)
GMAIL_USER=eiwittensmailer@gmail.com
GMAIL_PASSWORD=

# Bearer token Cloud Scheduler will send in Authorization header
SCRAPE_SECRET=
